{
  "name": "playwright-firebase",
  "version": "0.0.0-development",
  "description": "Utilities and fixtures to help test Firebase projects with Playwright.",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "type": "commonjs",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib"
  ],
  "workspaces": [
    "examples/*"
  ],
  "scripts": {
    "clean": "rimraf lib",
    "build": "tsc",
    "watch": "tsc --watch",
    "format": "biome format --write",
    "lint": "biome lint",
    "lint:fix": "biome lint --write",
    "check": "biome check",
    "test:base": "vitest run",
    "test:watch": "vitest",
    "emulators": "firebase emulators:start --only auth,firestore,database --project demo-test",
    "test": "firebase emulators:exec --only auth,firestore,database --project demo-test \"npm run test:base\"",
    "example:test": "npm run build && npm run test:e2e --workspace examples/basic"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.40.0",
    "firebase-admin": ">=12.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.5",
    "firebase-admin": "^14.5.0",
    "firebase-tools": "^15.32.1",
    "rimraf": "^6.1.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "keywords": [
    "playwright",
    "firebase",
    "testing",
    "e2e",
    "emulator"
  ],
  "license": "MIT",
  "author": {
    "name": "Prescott Prue",
    "url": "https://github.com/prescottprue"
  },
  "engines": {
    "node": ">=20"
  }
}
