# Used by `vite --mode test` (the Playwright webServer). All values are for
# the local emulators; "demo-" projects can never reach real Firebase services.
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_PROJECT_ID=demo-playwright-firebase
VITE_USE_EMULATORS=true
VITE_AUTH_EMULATOR_HOST=127.0.0.1:9199
VITE_FIRESTORE_EMULATOR_HOST=127.0.0.1:8180
VITE_DATABASE_EMULATOR_HOST=127.0.0.1:9100
